/* ============ ABOUT US ============ */

.about-hero .hero-panel__content { max-width: 620px; }

/* ---------- Quick stats strip ---------- */
.about-stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 26px;
}
@media (max-width: 900px) { .about-stat-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .about-stat-grid { grid-template-columns: 1fr; } }

.about-stat-card {
  padding: 20px 20px 18px;
  text-align: center;
}
.about-stat-value {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 26px;
  font-weight: 700;
  color: var(--green-dark);
  margin-bottom: 4px;
}
.about-stat-label {
  font-size: 12.5px;
  color: var(--muted);
  font-weight: 600;
}

/* ---------- Mission / Vision split ---------- */
.about-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 26px;
}
@media (max-width: 760px) { .about-split { grid-template-columns: 1fr; } }

.about-copy {
  font-size: 14.5px;
  line-height: 1.75;
  color: var(--muted);
  margin: 0;
}

/* ---------- Values grid ---------- */
.values-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}
@media (max-width: 900px) { .values-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .values-grid { grid-template-columns: 1fr; } }

.value-item {
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 12px;
  transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}
.value-item:hover {
  border-color: rgba(24,128,76,0.3);
  transform: translateY(-3px);
  box-shadow: 0 10px 22px rgba(20,35,28,0.08);
}
.value-icon {
  width: 38px; height: 38px;
  border-radius: 10px;
  background: var(--green-tint);
  color: var(--green);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 12px;
}
.value-icon svg { width: 19px; height: 19px; }
.value-title { font-weight: 700; font-size: 14.5px; margin-bottom: 6px; color: var(--ink); }
.value-desc { font-size: 13px; line-height: 1.6; color: var(--muted); }

/* ---------- Bottom CTA banner ---------- */
.about-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
  background: linear-gradient(135deg, var(--ink) 0%, #0F3D28 55%, var(--green-dark) 100%);
  color: var(--white);
  border-radius: var(--radius);
  padding: 30px 32px;
  margin-top: 26px;
}
.about-cta__content h2 {
  color: var(--white);
  font-size: 20px;
  margin-bottom: 6px;
}
.about-cta__content p {
  color: #C9E3D4;
  font-size: 13.5px;
  margin: 0;
}
.about-cta__actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  flex-shrink: 0;
}
.about-cta .btn-ghost {
  background: transparent;
  color: var(--white);
  border: 1px solid rgba(255,255,255,0.35);
}
.about-cta .btn-ghost:hover { border-color: var(--white); background: rgba(255,255,255,0.08); }
