/* ============ ABOUT US ============
   Self-contained: does not depend on dashboard.css.
   Motif: circuit trace / schematic. The stat strip extends the
   hero pulse-trace into the page as the page's one signature device;
   everything else (modules, values, cta) stays quiet and structural. */

@media (prefers-reduced-motion: no-preference) {
  .reveal { animation: aboutFadeUp 0.5s ease both; }
  @keyframes aboutFadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
}

/* ---------- Hero (self-contained, does not rely on dashboard.css) ---------- */
.about-hero-panel {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius);
  background: linear-gradient(135deg, var(--ink) 0%, #0F3D28 55%, var(--green-dark) 100%);
  color: var(--white);
  padding: 40px 40px 38px;
  margin-bottom: 22px;
}
.about-hero-panel__pattern {
  position: absolute;
  inset: 0;
  opacity: 0.22;
  pointer-events: none;
}
.about-hero-panel__pattern svg { width: 100%; height: 100%; display: block; }
.about-hero-panel__pattern .trace { fill: none; stroke: rgba(255,255,255,0.35); stroke-width: 1; }
.about-hero-panel__pattern .node { fill: rgba(255,255,255,0.35); }
.about-hero-panel__pattern .pulse {
  fill: none;
  stroke: var(--spark);
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-dasharray: 12 420;
  animation: aboutPulseTravel 5s linear infinite;
}
@keyframes aboutPulseTravel { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -432; } }
@media (prefers-reduced-motion: reduce) { .about-hero-panel__pattern .pulse { animation: none; } }

.about-hero-panel__content { position: relative; max-width: 620px; }
.about-hero-eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11.5px;
  letter-spacing: 1.5px;
  color: var(--spark);
  margin-bottom: 12px;
  text-transform: uppercase;
}
.about-hero-panel h1 { font-size: 30px; color: var(--white); margin-bottom: 12px; line-height: 1.2; }
.about-hero-sub { color: #C9E3D4; font-size: 14.5px; line-height: 1.65; margin: 0 0 24px 0; }
.about-hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

.btn-ghost-dark {
  background: transparent;
  color: var(--white);
  border: 1px solid rgba(255,255,255,0.35);
}
.btn-ghost-dark:hover { border-color: var(--white); background: rgba(255,255,255,0.08); }

/* ---------- Spec strip: the signature device, a trace connecting stats ---------- */
.spec-strip {
  position: relative;
  display: flex;
  margin-bottom: 30px;
  padding-top: 22px;
}
.spec-strip::before {
  content: "";
  position: absolute;
  top: 4px; left: 0; right: 0;
  border-top: 1px dashed var(--line);
}
.spec-item {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 0 12px;
}
.spec-item::before {
  content: "";
  position: absolute;
  top: -8px; left: 50%;
  transform: translateX(-50%);
  width: 9px; height: 9px;
  border-radius: 50%;
  background: var(--white);
  border: 2px solid var(--spark);
}
.spec-value {
  display: block;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 23px;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 4px;
}
.spec-label {
  display: block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--muted);
}
@media (max-width: 720px) {
  .spec-strip { flex-wrap: wrap; row-gap: 24px; }
  .spec-strip::before { display: none; }
  .spec-item { flex: 1 1 45%; }
}

/* ---------- Mission / Vision modules: schematic reference-mark cards ---------- */
.about-modules {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 22px;
}
@media (max-width: 760px) { .about-modules { grid-template-columns: 1fr; } }

.module-card {
  position: relative;
  padding: 28px 26px 26px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--white);
}
.module-card::before,
.module-card::after {
  content: "";
  position: absolute;
  width: 14px; height: 14px;
  pointer-events: none;
}
.module-card::before {
  top: 10px; left: 10px;
  border-top: 2px solid var(--spark);
  border-left: 2px solid var(--spark);
}
.module-card::after {
  bottom: 10px; right: 10px;
  border-bottom: 2px solid var(--spark);
  border-right: 2px solid var(--spark);
}
.module-tag {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.08em;
  color: var(--green-dark);
  margin-bottom: 14px;
}
.module-tag .pad {
  width: 6px; height: 6px;
  background: var(--spark);
  display: inline-block;
}
.module-card h3 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--ink);
  margin: 0 0 10px;
  line-height: 1.3;
}
.module-card p {
  font-size: 13.5px;
  line-height: 1.7;
  color: var(--muted);
  margin: 0;
}

/* ---------- Values: datasheet-style feature list ---------- */
.value-panel { margin-bottom: 22px; }
.value-legend { display: flex; flex-direction: column; }
.value-row {
  display: grid;
  grid-template-columns: 16px 190px 1fr;
  gap: 18px;
  align-items: start;
  padding: 16px 4px;
  border-bottom: 1px dashed var(--line);
}
.value-row:last-child { border-bottom: none; }
.value-row .node {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--green);
  margin-top: 6px;
}
.value-label {
  font-weight: 700;
  font-size: 14px;
  color: var(--ink);
}
.value-desc {
  font-size: 13.5px;
  line-height: 1.65;
  color: var(--muted);
}
@media (max-width: 640px) {
  .value-row { grid-template-columns: 16px 1fr; row-gap: 6px; }
  .value-desc { grid-column: 2 / 3; }
}

/* ---------- CTA banner ---------- */
.about-cta {
  background: linear-gradient(135deg, var(--ink) 0%, #0F3D28 55%, var(--green-dark) 100%);
  color: var(--white);
  border-radius: var(--radius);
  padding: 30px 32px 32px;
  margin-top: 4px;
}
.about-cta__status {
  display: inline-block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  letter-spacing: 0.06em;
  color: var(--spark);
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 20px;
  padding: 5px 12px;
  margin-bottom: 16px;
}
.about-cta__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}
.about-cta__content h2 { color: var(--white); font-size: 20px; margin-bottom: 6px; }
.about-cta__content p { color: #C9E3D4; font-size: 13.5px; margin: 0; }
.about-cta__actions { display: flex; gap: 12px; flex-wrap: wrap; flex-shrink: 0; }

/* ---------- Our Team ---------- */
.team-panel { margin-bottom: 22px; }

.team-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 20px;
}

.team-card {
  border-radius: 14px;
  border: 1px solid var(--line);
  background: var(--white);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.team-card:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(20,35,28,0.10); }

.team-card__image-wrap {
  aspect-ratio: 4 / 5;
  width: 100%;
  overflow: hidden;
  background: var(--green-tint);
}
.team-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
}
.team-card__image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--ink) 0%, #0F3D28 60%, var(--green-dark) 100%);
  color: rgba(255,255,255,0.5);
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: 11px;
  letter-spacing: 1px;
  text-transform: uppercase;
  text-align: center;
  padding: 10px;
}

.team-card__accent {
  height: 3px;
  background: linear-gradient(90deg, var(--green), var(--spark));
}

.team-card__body {
  padding: 14px 14px 16px;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}
.team-card__name {
  font-weight: 700;
  font-size: 14px;
  color: var(--ink);
}
.team-card__role {
  font-size: 12px;
  line-height: 1.55;
  color: var(--muted);
}

.team-delete-btn {
  margin-top: 8px;
  align-self: center;
  color: #A3342F;
  font-size: 11.5px;
  padding: 4px 10px;
}

/* ---------- Admin: add team member form ---------- */
.team-admin-form-card {
  border-top: 1px dashed var(--line);
  margin-top: 22px;
  padding-top: 4px;
}
.team-add-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-width: 420px;
}
.team-add-form input,
.team-add-form textarea {
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  font-size: 13.5px;
  font-family: inherit;
  resize: vertical;
}
.team-file-label {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--muted);
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.team-add-form button { align-self: flex-start; }
