<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Spark Technologies</title>
  <link rel="icon" href="assets/logo.png" type="image/png">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/auth.css">
</head>
<body>

  <button class="sidebar-toggle" aria-label="Toggle menu">&#9776;</button>

  <div class="app-shell">

    <aside class="sidebar">
      <div class="sidebar__logo">
        <img src="assets/logo-sidebar.png" alt="Spark Technologies">
      </div>

      <nav>
        <span class="nav-label">MAIN</span>
        <a class="nav-link" href="index.html"><span class="dot"></span> Home</a>
        <a class="nav-link" href="courses.html"><span class="dot"></span> Courses</a>
        <a class="nav-link" href="projects.html"><span class="dot"></span> Projects</a>
        <a class="nav-link" href="about.html"><span class="dot"></span> About Us</a>
        <a class="nav-link" href="contact.html"><span class="dot"></span> Contact Us</a>

        <span class="nav-label">ACCOUNT</span>
        <a class="nav-link" href="login.html"><span class="dot"></span> Login</a>
        <a class="nav-link" href="register.html"><span class="dot"></span> Create Account</a>
      </nav>

      <div class="sidebar__footer">(c) 2026 Spark Technologies</div>
    </aside>

    <main class="main">

      <div class="topbar">
        <div class="topbar__title">
          <p class="eyebrow">ACCOUNT</p>
          <h1>Welcome back</h1>
        </div>
      </div>

      <div class="auth-wrap">
        <div class="card auth-card">
          <h2>Log in</h2>
          <p class="auth-sub">Log in to access your courses and dashboard.</p>

          <div class="auth-message" id="auth-message"></div>

          <form id="login-form" novalidate>
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required>

            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Your password" required>

            <button type="submit" class="btn btn-primary auth-submit" id="login-submit">Log in</button>
          </form>

          <p class="auth-switch">Don't have an account? <a href="register.html">Create one</a></p>
        </div>
      </div>

      <div class="site-footer-note">
        <span>Spark Technologies - changing ideas into a smart solution.</span>
        <span>Home . Courses . Projects . About Us . Contact Us</span>
      </div>

    </main>
  </div>

  <script src="js/main.js"></script>
  <script src="js/auth.js"></script>
</body>
</html>

